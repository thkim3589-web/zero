<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Jijang" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- 버튼/카드 등 "작은 컴포넌트" 모서리를 한 곳에서 둥글게 — 화면마다 손댈 필요 없이
             앱 전체 버튼이 한 번에 더 부드러운 인상으로 바뀐다. -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Jijang.SmallComponent</item>

        <item name="materialButtonStyle">@style/Widget.Jijang.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Jijang.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Jijang.Button.Text</item>
    </style>

    <style name="ShapeAppearance.Jijang.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">10dp</item>
    </style>

    <!-- 핵심 동작(저장/추가/업로드 등) 버튼 — 주황 배경, 둥근 모서리, 여유있는 높이 -->
    <style name="Widget.Jijang.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 보조 동작(취소/초기화/부가 항목 추가 등) 버튼 — 남색 테두리 -->
    <style name="Widget.Jijang.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Jijang.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/accent_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 접었다 펼 수 있는 섹션 헤더 (체크리스트 입력 화면 전용) -->
    <style name="SectionHeaderCollapsible" parent="SectionHeader">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SubHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- 카드 안 텍스트 입력칸 공통 스타일 — 참고 웹앱처럼 옅은 테두리 박스 형태 -->
    <style name="Widget.Jijang.EditText" parent="android:Widget.EditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
