<?xml version="1.0" encoding="utf-8"?>
<!-- 디자인 시안 v4 기준 팔레트: 슬레이트(헤더/구조) + 블루(핵심 동작) + 앰버/그린(상태).
     화면/Kotlin 코드에서는 HEX를 직접 쓰지 말고 이 파일의 이름만 참조한다. -->
<resources>
    <!-- 구조: 헤더/툴바/아웃라인 -->
    <color name="primary">#0F172A</color>
    <color name="primary_light">#475569</color>
    <color name="primary_dark">#020617</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_muted">#CBD5E1</color>

    <!-- 핵심 동작(저장/추가/선택) -->
    <color name="accent">#2563EB</color>
    <color name="accent_dark">#1D4ED8</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- 바탕/구분선/글자 -->
    <color name="background">#F1F5F9</color>
    <color name="surface">#FFFFFF</color>
    <color name="line">#E2E8F0</color>
    <color name="text_primary">#1E293B</color>
    <color name="text_secondary">#64748B</color>

    <!-- 상태 -->
    <color name="status_ok">#059669</color>
    <color name="status_warn">#DC2626</color>

    <!-- 현장 상세 메뉴 카드 아이콘 배지 -->
    <color name="badge_teal">#059669</color>
    <color name="badge_purple">#7C3AED</color>
    <color name="badge_blue">#2563EB</color>
    <color name="badge_amber">#D97706</color>

    <!-- 상태 칩: 작성중=앰버, 제출=블루, 내보냄=그린 -->
    <color name="status_draft_bg">#FEF3C7</color>
    <color name="status_draft_text">#92400E</color>
    <color name="status_submitted_bg">#DBEAFE</color>
    <color name="status_submitted_text">#1D4ED8</color>
    <color name="status_exported_bg">#D1FAE5</color>
    <color name="status_exported_text">#047857</color>

    <!-- 공통 보조 -->
    <color name="accent_soft">#EFF6FF</color>
    <color name="surface_muted">#F8FAFC</color>
    <color name="danger_soft">#FEF2F2</color>
    <color name="icon_muted">#94A3B8</color>
    <color name="scrim">#B3000000</color>
    <color name="select_bg">#F8FAFC</color>
</resources>
