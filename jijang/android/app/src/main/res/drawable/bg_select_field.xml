<?xml version="1.0" encoding="utf-8"?>
<!-- 눌러서 목록에서 고르는 칸 — 입력칸(흰 배경)과 구분되도록 옅은 배경 + 진한 테두리 + 눌림 효과 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/line">
    <item>
        <shape>
            <solid android:color="@color/select_bg" />
            <corners android:radius="@dimen/field_radius" />
            <stroke android:width="1dp" android:color="@color/primary_light" />
            <padding android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp" />
        </shape>
    </item>
</ripple>
