<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="@color/on_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.thkim.jijang.ui.diagram.RouteEditorView
            android:id="@+id/routeEditorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface" />

        <LinearLayout
            android:id="@+id/textNoImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_card_notice"
            android:padding="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_menu_map"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="GIS 캡처 이미지를 먼저 불러오세요"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="편집할 선"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerLineChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 범례 선 종류 / 범례 도형 심볼 선택 (SKT 개황도 범례 그대로) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLegendLine"
                style="@style/Widget.Jijang.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="선 종류 ▾" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLegendSymbol"
                style="@style/Widget.Jijang.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="도형 심볼 ▾" />
        </LinearLayout>

        <!-- 실행 취소 / 다시 실행 / 조준(드래그 시 점을 손가락 위로 띄움) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonUndo"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:paddingHorizontal="2dp"
                android:textSize="12sp"
                style="@style/Widget.Jijang.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="↶ 되돌리기" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRedo"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:paddingHorizontal="2dp"
                android:textSize="12sp"
                style="@style/Widget.Jijang.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="↷ 다시" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAim"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:paddingHorizontal="2dp"
                android:textSize="12sp"
                style="@style/Widget.Jijang.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="조준 ON" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOrtho"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:maxLines="1"
                android:paddingHorizontal="2dp"
                android:textSize="12sp"
                style="@style/Widget.Jijang.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:text="직각 OFF" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonShapePlain"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_toolbar_toggle"
                    android:contentDescription="일반 경로점"
                    android:padding="9dp"
                    android:src="@drawable/ic_shape_plain" />

                <TextView
                    android:id="@+id/buttonShapeEnclosure"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_toolbar_toggle"
                    android:contentDescription="함체"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="@color/badge_blue"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/buttonShapePole"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_toolbar_toggle"
                    android:contentDescription="전주"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/status_ok"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/buttonShapeConnection"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_toolbar_toggle"
                    android:contentDescription="접속점"
                    android:padding="9dp"
                    android:src="@drawable/ic_shape_connection" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/line" />

                <ImageButton
                    android:id="@+id/buttonLineColor"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_toolbar_toggle"
                    android:contentDescription="선 색상"
                    android:padding="11dp"
                    android:src="@drawable/bg_icon_badge" />

                <ImageButton
                    android:id="@+id/buttonLineDashed"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_toolbar_toggle"
                    android:contentDescription="선 종류"
                    android:padding="9dp"
                    android:src="@drawable/ic_line_style_solid" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonResetZoom"
                    style="@style/Widget.Jijang.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="확대 초기화" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonHideOtherLines"
                    style="@style/Widget.Jijang.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="다른 선 숨기기" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageLegendThumb"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_menu_map" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="범례 이미지"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPickLegend"
                style="@style/Widget.Jijang.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="첨부" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRemoveLegend"
                style="@style/Widget.Jijang.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="제거"
                android:textColor="@color/status_warn"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPickImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="이미지 불러오기" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPickFromExcel"
                style="@style/Widget.Jijang.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="엑셀에서 가져오기" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClear"
                style="@style/Widget.Jijang.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="선 초기화" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="저장" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
