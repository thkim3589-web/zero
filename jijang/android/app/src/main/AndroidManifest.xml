<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".JijangApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Jijang"
        android:supportsRtl="true">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Jijang">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.casedetail.CaseDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Jijang" />

        <activity
            android:name=".ui.diagram.DiagramEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Jijang" />

        <activity
            android:name=".ui.checklist.ChecklistEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Jijang" />

        <activity
            android:name=".ui.photo.PhotoListActivity"
            android:exported="false"
            android:theme="@style/Theme.Jijang" />

        <activity
            android:name=".ui.priceupload.PriceUploadActivity"
            android:exported="false"
            android:theme="@style/Theme.Jijang" />

        <activity
            android:name=".ui.workquantity.WorkQuantityEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Jijang" />

        <activity
            android:name=".ui.routesegment.RouteSegmentEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Jijang" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
